local fs = require("@lune/fs")
local luau = require("@lune/luau")
local Display = luau.load(fs.readFile("src/client/RoomDisplay.luau"))()
assert(Display.state("WAITING") == "WAITING")
assert(Display.state("STARTING") == "STARTING")
assert(Display.state("COUNTDOWN") == "STARTING")
assert(Display.state("RACING") == "RACING")
assert(Display.state("FINISHING") == "FINISHING")
assert(Display.state("ROUND_COMPLETE") == "RESULTS")
assert(Display.canJoin({ state = "WAITING", count = 3, maxPlayers = 4 }))
assert(not Display.canJoin({ state = "WAITING", count = 4, maxPlayers = 4 }))
assert(not Display.canJoin({ state = "RACING", count = 2, maxPlayers = 4 }))
print("M3-A2 room display validation PASS")
