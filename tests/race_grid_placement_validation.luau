-- Real RaceController/RaceSession with deterministic transport and seating.
local fs,luau=require('@lune/fs'),require('@lune/luau')
local source=fs.readFile('tests/persistent_room_race_validation.luau'):gsub('\r\n','\n')
source=source:gsub('require%("%./helpers/gameplay_config"%)','_gameplay')
local prefix=source:sub(1,assert(source:find('\nready(a)\n',1,true))-1)
luau.load(prefix..'\n'..[====[
services.Workspace:SetAttribute('KDMServerRole','RACE')
a:SetAttribute('RaceArrivalOrder',10)
b:SetAttribute('RaceArrivalOrder',30)
c:SetAttribute('RaceArrivalOrder',20)
ready(a)
local bot,botContext=addPlayer('ServerBot',99,4)
bot.Parent=services.ReplicatedStorage
bot:SetAttribute('IsBot',true)
check(session:addServerBot(bot,botContext,'PRODUCTION_ROOM'),'production bot admitted through unchanged authority gate')
local slots=catalog.Entries.Track01Race.GridSlots
local function placed(player,context,index)
 check(player:GetAttribute('GridSlot')==index,'physical slot index '..player.Name)
 local frame=context.kart:GetAttribute('RaceStartCFrame')
 check((frame.Position-slots[index].Position).Magnitude<.001,'start frame aligned '..player.Name)
 check(frame.LookVector:Dot(slots[index].LookVector)>.99999,'forward heading '..player.Name)
 check((context.chassis.Position-frame.Position).Magnitude<.001,'actual seated kart moved '..player.Name)
 local h=player.Character:FindFirstChildOfClass('Humanoid')
 check(context.seat.Occupant==h and h.SeatPart==context.seat,'seat relationship retained '..player.Name)
end
placed(a,ca,1);placed(bot,botContext,2)
check(bot:GetAttribute('ReadyOrder')==4,'logical bot reservation remains separate from physical front row')
ready(b)
placed(a,ca,1);placed(b,cb,2);placed(bot,botContext,3)
ready(c)
check(session.phase=='COUNTDOWN','four eligible racers use existing full-room start')
placed(a,ca,1);placed(c,cc,2);placed(b,cb,3);placed(bot,botContext,4)
check(session:orderedParticipants()[2]==c,'entry order wins over seat completion / reserved order')
tick(raceConfig.COUNTDOWN_SECONDS+.1)
check(session.phase=='RACING','normal GO retained')
for _,context in {ca,cb,cc,botContext}do context.chassis.CFrame=CF.new(1500,0,1500)end
tick(raceConfig.OFF_TRACK_TIMEOUT_SECONDS+.1)
check(session.phase=='COMPLETE','normal terminal round retained')
for _,p in {a,b,c}do remote:Fire(p,'Rematch')end
check(session.phase=='WAITING','same-server Rematch returns to staging')
placed(a,ca,1);placed(c,cc,2);placed(b,cb,3);placed(bot,botContext,4)
b:SetAttribute('RaceState','GARAGE');tick(.1)
placed(a,ca,1);placed(c,cc,2);placed(bot,botContext,3)
check(session:humanCount()==2 and session:count()==3,'departure compacts paint slots without changing capacity')
print('PASS: '..count..' real-controller entry order / 1H1B front row / late seating / countdown / GO / Rematch / departure checks')
]====],{environment={_gameplay=require('./helpers/gameplay_config')}})()
